{
  "name": "hivemind-agents",
  "version": "0.1.3",
  "description": "A shared, live plan for teams of coding agents (Claude Code, Codex, Cursor). Syncs through your git remote: no server, no account.",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "multi-agent",
    "collaboration",
    "hackathon",
    "planning",
    "git"
  ],
  "homepage": "https://github.com/Leonhest/hivemind#readme",
  "bugs": "https://github.com/Leonhest/hivemind/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonhest/hivemind.git"
  },
  "license": "MIT",
  "author": "Leonhest",
  "type": "module",
  "bin": {
    "hivemind": "dist/hivemind.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "mcpName": "io.github.Leonhest/hivemind",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
