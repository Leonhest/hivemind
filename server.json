{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Leonhest/hivemind",
  "description": "A shared, live plan for teams of coding agents, synced through your git remote.",
  "repository": {
    "url": "https://github.com/Leonhest/hivemind",
    "source": "github"
  },
  "version": "0.1.5",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "hivemind-agents",
      "version": "0.1.5",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
