            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hivemind.mjs\" hook claude SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
